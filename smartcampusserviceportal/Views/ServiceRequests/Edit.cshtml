@model smartcampusserviceportal.Models.ServiceRequest
@{
    ViewBag.Title = "Edit service request";
}

<h2>Edit service request</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "Please correct the errors below.", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(model => model.Title, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Title, null, new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Description, new { @class = "form-label" })
        @Html.TextAreaFor(model => model.Description, 5, 40, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Status, new { @class = "form-label" })
        @Html.DropDownListFor(model => model.Status, new SelectList(new[] { "Open", "In progress", "Resolved" }), new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.Status, null, new { @class = "text-danger" })
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
